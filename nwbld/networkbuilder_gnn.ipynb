import numpy as np

# Example weights
df["weight"] = np.random.rand(len(df))


def weighted_distance(lat1, lon1, w1, lat2, lon2, w2, alpha=1.0):
    """
    Compute a weighted geographic distance.

    Parameters
    ----------
    lat1, lon1 : float
        Coordinates of the first location.
    lat2, lon2 : float
        Coordinates of the second location.
    w1, w2 : float
        Neural weights associated with each location.
    alpha : float
        Controls the influence of the weight difference.

    Returns
    -------
    float
        Weighted distance.
    """
    geo_dist = haversine(lat1, lon1, lat2, lon2)
    weight_diff = abs(w1 - w2)

    return geo_dist * (1 + alpha * weight_diff)

n = len(df)
weighted_matrix = np.zeros((n, n))

## for easy conversion, direct distance is calculated. the restriction of the math is that it doesn't take into account actual traffic distance. correct this by introducing noise modelling with 10-20% deviation. 

### matrix weight can be extracted from the formula
###i for indexing x, j for indexing y


for i in range(n):
    for j in range(n):
        weighted_matrix[i, j] = weighted_distance(
            df.loc[i, "latitude"],
            df.loc[i, "longitude"],
            df.loc[i, "weight"],
            df.loc[j, "latitude"],
            df.loc[j, "longitude"],
            df.loc[j, "weight"],
            alpha=0.5
        )

weighted_matrix = pd.DataFrame(
    weighted_matrix,
    index=df["location"],
    columns=df["location"]
)

print(weighted_matrix)



